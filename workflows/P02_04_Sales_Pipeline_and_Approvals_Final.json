    {
      "parameters": {
        "authentication": "n8nUserAuth",
        "requireExecuteAccess": true,
        "formTitle": "Sales Proposal Review",
        "formDescription": "Private reviewer-only form. Check the draft and indicative pricing before approving.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Proposal Reference",
              "fieldName": "quote_id",
              "requiredField": true
            },
            {
              "fieldLabel": "Decision",
              "fieldType": "dropdown",
              "fieldName": "approval_decision",
              "fieldOptions": {
                "values": [
                  {
                    "option": "approve"
                  },
                  {
                    "option": "reject"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Pricing and scope reviewed?",
              "fieldType": "dropdown",
              "fieldName": "pricing_confirmed",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Yes"
                  },
                  {
                    "option": "No"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Reviewer",
              "fieldName": "reviewer",
              "requiredField": true
            },
            {
              "fieldLabel": "Review notes (required for rejection)",
              "fieldType": "textarea",
              "fieldName": "review_notes"
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "includeUserInOutput": true
        }
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        1168,
        1712
      ],
      "id": "32ce176b-e513-4851-9847-70ae640efd2e",
      "name": "ReviewProposalForm"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const s=v=>String(v??'').trim();\nconst quote_id=s($json.quote_id);\nconst decision=s($json.approval_decision).toLowerCase();\nconst reviewer=s($json.reviewer);\nconst notes=s($json.review_notes);\nconst confirmed=s($json.pricing_confirmed)==='Yes';\nconst valid=quote_id.length>5&&['approve','reject'].includes(decision)&&reviewer.length>1&&(decision!=='approve'||confirmed)&&(decision!=='reject'||notes.length>3);\nreturn {json:{valid,quote_id,decision,reviewer,notes,confirmed,reason:valid?'':'Check quote reference, reviewer, pricing confirmation, or rejection explanation.'}};"
      },
