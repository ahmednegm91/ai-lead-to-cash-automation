        "jsCode": "const r=$('PrepareReviewRequest').first().json;\nconst p=$('LoadProposalForReview').first().json||{};\nconst o=$('LoadOpportunityForReview').first().json||{};\nconst errs=[];\nif(!p.quote_id||p.quote_id!==r.quote_id)errs.push('Proposal not found');\nif(!o.opportunity_id||o.quote_id!==r.quote_id)errs.push('Opportunity not found');\nif(p.approval_status!=='pending_review')errs.push('Proposal is not pending review');\nif(o.approval_status!=='pending_review')errs.push('Opportunity is not pending review');\nif(p.lead_id&&o.lead_id&&p.lead_id!==o.lead_id)errs.push('Lead reference mismatch');\nif(r.decision==='approve'&&!(Number(p.indicative_subtotal_usd)>0))errs.push('Missing approved fee');\nif(String(r.quote_id).startsWith('SAMPLE'))errs.push('Sample rows cannot be approved');\nconst approved=r.decision==='approve', now=new Date().toISOString();\nreturn {json:{...r,valid:errs.length===0,reason:errs.join('; '),opportunity_id:o.opportunity_id||'',lead_id:p.lead_id||'',approval_status:approved?'approved':'rejected',stage:approved?'proposal_approved':'proposal_rejected',decided_at:now,updated_at:now,last_action:approved?'Approved: create draft contract and invoice':'Rejected: contact client or close opportunity',event_id:'APR-'+r.quote_id+'-'+String($execution.id||Date.now())}};"
      },
