        "jsCode": "const input=$('NormalizeOpportunityInput').first().json;\nconst p=$('FindStoredProposal').first().json||{};\nconst amt=Number(p.indicative_subtotal_usd);\nconst ok=Boolean(p.quote_id===input.quote_id&&p.lead_id===input.lead_id&&p.approval_status==='pending_review'&&Number.isFinite(amt)&&amt>0&&!String(p.quote_id).startsWith('SAMPLE'));\nreturn {json:{valid:ok,reason:ok?'':'Stored proposal missing, wrong status, or illustrative fee absent. Run proposal generation first.',quote_id:input.quote_id,lead_id:input.lead_id,company:p.company||'',service_needed:p.service_needed||'',estimated_value_usd:amt}};"
